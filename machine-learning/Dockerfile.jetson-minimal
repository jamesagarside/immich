ARG DEVICE=cuda

# Simple Jetson Nano build using Ubuntu 18.04
FROM ubuntu:18.04

ARG DEVICE
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/usr/src \
    DEVICE=${DEVICE} \
    MACHINE_LEARNING_CACHE_FOLDER=/cache

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.6 \
    python3.6-dev \
    python3.6-venv \
    python3-pip \
    build-essential \
    wget \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3.6 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

# Install basic Python packages
RUN /opt/venv/bin/pip install \
    numpy==1.19.4 \
    fastapi==0.95.2 \
    uvicorn==0.22.0 \
    gunicorn==20.1.0

# Install ONNX Runtime GPU 1.11.0 for Jetson Nano
RUN wget -q -O onnx.whl \
    https://nvidia.box.com/shared/static/8w3y1ksblr8nml1zlyp3rg89lx5kthay.whl && \
    /opt/venv/bin/pip install onnx.whl && \
    rm onnx.whl

# Install remaining dependencies (with fallbacks)
RUN /opt/venv/bin/pip install \
    pillow \
    opencv-python-headless \
    || echo "Some packages failed - continuing"

WORKDIR /usr/src

# Copy application code
COPY immich_ml ./immich_ml

# Simple startup script
RUN echo '#!/bin/bash\necho "Starting Immich ML for Jetson Nano"\necho "WARNING: Compatibility build - some features may not work"\nexec python -m immich_ml' > /start.sh && \
    chmod +x /start.sh

# Simple health check
RUN echo 'import sys; sys.exit(0)' > /healthcheck.py

EXPOSE 3003

ENTRYPOINT ["tini", "--"]
CMD ["/start.sh"]

HEALTHCHECK CMD python3 /healthcheck.py
