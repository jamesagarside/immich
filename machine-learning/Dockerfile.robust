FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Install packages including curl for better download handling
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.6 \
    python3.6-venv \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create venv and install minimal packages
RUN python3.6 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install fastapi uvicorn numpy

# Try to download ONNX Runtime with fallback
RUN curl -L -o onnx.whl \
    "https://nvidia.box.com/shared/static/8w3y1ksblr8nml1zlyp3rg89lx5kthay.whl" \
    || echo "ONNX Runtime download failed - container will work without GPU acceleration"

# Install ONNX Runtime if download succeeded
RUN if [ -f onnx.whl ] && [ -s onnx.whl ]; then \
        /opt/venv/bin/pip install onnx.whl && rm onnx.whl; \
    else \
        echo "Skipping ONNX Runtime installation"; \
    fi

WORKDIR /app

# Copy immich_ml if it exists
COPY immich_ml ./immich_ml

# Create fallback test app
RUN if [ ! -d "immich_ml" ]; then \
        echo 'from fastapi import FastAPI\napp = FastAPI()\n@app.get("/")\ndef root(): return {"status": "Jetson container running", "onnx": "check /test"}\n@app.get("/ping")\ndef ping(): return {"pong": True}\n@app.get("/test")\ndef test():\n    try:\n        import onnxruntime as ort\n        return {"onnx_version": ort.__version__, "providers": ort.get_available_providers()}\n    except:\n        return {"onnx": "not available"}\nif __name__ == "__main__": import uvicorn; uvicorn.run(app, host="0.0.0.0", port=3003)' > main.py; \
    fi

EXPOSE 3003

# Start immich_ml if available, otherwise start test app  
CMD if [ -d "immich_ml" ]; then python -m immich_ml; else python main.py; fi
