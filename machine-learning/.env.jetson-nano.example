# Environment file for Immich on Jetson Nano
# Copy this to .env and modify as needed

# The Immich version to run
IMMICH_VERSION=release

# Database credentials - CHANGE THESE!
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Upload location - where your photos will be stored
# Make sure this path exists and has enough space
UPLOAD_LOCATION=/mnt/immich-data/upload

# Optional: Model cache location
# If not set, docker will create a volume
MODEL_CACHE_LOCATION=/mnt/immich-data/model-cache

# Jetson Nano specific settings
# Uncomment and modify if needed

# Force CPU-only mode if GPU doesn't work
# DEVICE=cpu

# Reduce memory usage (uncomment if needed)
# MACHINE_LEARNING_WORKERS=1
# MACHINE_LEARNING_WORKER_TIMEOUT=120

# GPU memory fraction (0.0 to 1.0)
# Useful if you want to limit GPU memory usage
# GPU_MEMORY_FRACTION=0.8
